    "./mat4": "./src/mat4.js",
    "./format": "./src/format.js",
    "./lz4": "./src/lz4.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "test/",
    "LICENSE",
    "README.md",
    "PROVENANCE.md"
  ],
  "sideEffects": false,
  "dependencies": {},
