{
  "name": "wallpaper-engine-web-loader",
  "version": "0.5.20",
  "description": "wallpaper-engine-web-loader 的壁纸插件内嵌运行时（仅保留 scene 渲染入口；不含开发服务器/测试台/PWA 调试面）",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XHR666/wallpaper-engine-web-loader.git"
  },
  "homepage": "https://xhr666.github.io/wallpaper-engine-web-loader/",
  "bugs": {
    "url": "https://github.com/XHR666/wallpaper-engine-web-loader/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./core/we-scene.mjs",
  "exports": {
    ".": "./core/we-scene.mjs",
    "./bundle": "./core/we-scene-bundle.js",
    "./hlsl2glsl": "./vendor/hlsl2glsl/hlsl2glsl.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD-PARTY.md",
    "PROVENANCE.md",
    "MODIFICATIONS.md",
    "demo.html",
    "core/",
    "elysia/",
    "assets/",
    "shaders/",
    "samples/",
    "vendor/",
    "web/diag-flags.json",
    "package.json"
  ],
  "keywords": [
    "wewebloader",
    "we-web-loader",
    "wallpaper-engine",
    "wallpaper-engine-web-loader",
    "webgl2",
    "scene-renderer",
    "scene-pkg",
    "we-scene",
    "壁纸渲染器"
  ]
}
